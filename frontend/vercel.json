{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/signup", "destination": "/pages/signup.html" },
    { "source": "/verify-otp", "destination": "/pages/verify-otp.html" },
    { "source": "/forgot-password", "destination": "/pages/forgot-password.html" },
    { "source": "/reset-password", "destination": "/pages/reset-password.html" },
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/profile", "destination": "/pages/profile.html" },
    { "source": "/aptitude", "destination": "/pages/aptitude.html" },
    { "source": "/coding", "destination": "/pages/coding.html" },
    { "source": "/interview", "destination": "/pages/interview.html" },
    { "source": "/admin", "destination": "/pages/admin.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
